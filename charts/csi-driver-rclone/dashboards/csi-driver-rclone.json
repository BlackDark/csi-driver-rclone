{
  "title": "csi-driver-rclone",
  "uid": "csi-driver-rclone",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "csi",
    "rclone"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(csi_rclone_requests_total, job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "volume",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(csi_rclone_transferred_bytes_total, volume_id)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CSI RPC rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(csi_rclone_requests_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CSI RPC errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, code) (rate(csi_rclone_requests_total{job=~\"$job\", code!=\"OK\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{code}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CSI RPC latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(csi_rclone_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Mount Pods by state",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (csi_rclone_mount_pods{job=~\"$job\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Unhealthy mounts",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "count(csi_rclone_mount_healthy{job=~\"$job\"} == 0) or vector(0)",
          "legendFormat": "unhealthy"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Lost mounts (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(csi_rclone_mount_lost_total{job=~\"$job\"}[1h]))",
          "legendFormat": "lost"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Mount Pod images",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "count by (image) (csi_rclone_mount_pod_info{job=~\"$job\"})",
          "legendFormat": "{{image}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Adoptions (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(csi_rclone_adoptions_total{job=~\"$job\"}[1h]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Drain outcomes (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(csi_rclone_drain_total{job=~\"$job\"}[1h]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Mount health by volume",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "min by (volume_id) (csi_rclone_mount_healthy{job=~\"$job\"})",
          "legendFormat": "{{volume_id}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Throughput by volume",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (volume_id) (rate(csi_rclone_transferred_bytes_total{volume_id=~\"$volume\"}[$__rate_interval]))",
          "legendFormat": "{{volume_id}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Transfer errors by volume",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (volume_id) (rate(csi_rclone_transfer_errors_total{volume_id=~\"$volume\"}[$__rate_interval]))",
          "legendFormat": "{{volume_id}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "VFS Cache usage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (volume_id) (csi_rclone_vfs_cache_bytes{volume_id=~\"$volume\"})",
          "legendFormat": "{{volume_id}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Upload queue",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (volume_id) (csi_rclone_vfs_uploads_queued{volume_id=~\"$volume\"})",
          "legendFormat": "{{volume_id}} queued"
        },
        {
          "refId": "B",
          "expr": "sum by (volume_id) (csi_rclone_vfs_uploads_in_progress{volume_id=~\"$volume\"})",
          "legendFormat": "{{volume_id}} in progress"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Cache errored files / out of space",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (volume_id) (csi_rclone_vfs_cache_errored_files{volume_id=~\"$volume\"})",
          "legendFormat": "{{volume_id}} errored"
        },
        {
          "refId": "B",
          "expr": "max by (volume_id) (csi_rclone_vfs_cache_out_of_space{volume_id=~\"$volume\"})",
          "legendFormat": "{{volume_id}} out of space"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Directory cache",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (volume_id) (csi_rclone_vfs_dir_cache_files{volume_id=~\"$volume\"})",
          "legendFormat": "{{volume_id}} files"
        },
        {
          "refId": "B",
          "expr": "sum by (volume_id) (csi_rclone_vfs_dir_cache_dirs{volume_id=~\"$volume\"})",
          "legendFormat": "{{volume_id}} dirs"
        }
      ]
    }
  ]
}
