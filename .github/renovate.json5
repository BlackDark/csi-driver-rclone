// Shared defaults live in BlackDark/renovate-base. Keep repo-specific rules here.
// Repo settings: enable "Allow auto-merge" and require the CI `check` on main.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>blackdark/renovate-base//default.json5",
    "github>blackdark/renovate-base//go.json5",
  ],
  updateNotScheduled: false,
  platformAutomerge: true,
  separateMultipleMajor: true,

  // Go: keep go.sum tidy (CI's `go mod tidy -diff` stays green); rewrite import paths on /vN majors.
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],

  // Pinned `image:tag@sha256:…` refs outside the built-in managers: e2e Go constants, e2e manifests.
  customManagers: [
    {
      customType: "regex",
      description: "Pinned image refs in e2e Go code and manifests",
      managerFilePatterns: ["/^test/e2e/.+\\.go$/", "/^hack/e2e/.+\\.ya?ml$/"],
      matchStrings: [
        "(?<depName>[a-z0-9][a-z0-9./-]*[a-z0-9]):(?<currentValue>[\\w][\\w.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
    },
  ],

  // Later rules override earlier ones: general first, specific after.
  packageRules: [
    {
      description: "Majors: one PR each, merged by hand",
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
      automerge: false,
    },
    {
      description: "Own image: chart tag defaults to appVersion, the release bumps it",
      matchPackageNames: ["ghcr.io/blackdark/csi-driver-rclone"],
      enabled: false,
    },
    {
      // Chainguard's free tier publishes only `latest`; track its digest.
      description: "Chainguard images: digest updates of the latest tag",
      matchPackageNames: ["cgr.dev/chainguard/**"],
      versioning: "docker",
      pinDigests: true,
    },
    {
      // rclone v1.75 requires it and parses rclone.conf with it; our direct use keeps
      // configData quoting identical to rclone's. Goes when rclone drops it.
      description: "goconfig: unmaintained but rclone's own config parser",
      matchPackageNames: ["github.com/unknwon/goconfig"],
      abandonmentThreshold: null,
    },
    {
      description: "shellcheck: slow release cadence, still the standard shell linter",
      matchPackageNames: ["shellcheck"],
      abandonmentThreshold: null,
    },
  ],
}
